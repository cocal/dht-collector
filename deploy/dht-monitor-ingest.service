[Unit]
Description=DHT monitor.v1 journal ingester
After=network-online.target dht-passive-collector.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/vibe/dht-collector
EnvironmentFile=/root/.config/dht-search/db.env
ExecStart=/usr/bin/java -Xms32m -Xmx256m -XX:+UseG1GC -jar /opt/dht-collector/dht-collector-java.jar --mode monitor-ingest --journal-unit dht-passive-collector.service --batch-size 128 --flush-ms 1000 --pool-size 1
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
