[Unit]
Description=Passive Mainline DHT collector (Java)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/vibe/dht-collector
EnvironmentFile=/root/.config/dht-search/db.env
TimeoutStartSec=90s
ExecStartPre=/usr/bin/find /root/vibe/dht-collector/var/java-dht -type f -name IPv4-table.cache -size 0 -delete
ExecStart=/usr/bin/java -Xms64m -Xmx640m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError -jar /opt/dht-collector/dht-collector-java.jar --mode collector --address 0.0.0.0 --port 51413 --dht-nodes 12 --max-concurrent 160 --metadata-concurrent 2 --metadata-timeout-seconds 10 --pool-size 2 --storage-path /root/vibe/dht-collector/var/java-dht
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65536
MemoryHigh=700M
MemoryMax=900M
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
