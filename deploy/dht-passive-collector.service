[Unit]
Description=Passive Mainline DHT collector (Node.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/vibe/dht-collector
EnvironmentFile=/root/.config/dht-search/db.env
Environment=PGPOOL_MAX=5
ExecStart=/usr/bin/node src/passive-collector.js --db /root/vibe/dht-collector/var/dht-search.db --quiet --port 51413 --dht-nodes 12 --max-resources 0 --max-concurrent 160 --dht-concurrency 80 --max-pending 1280 --lookup-timeout-ms 10000 --metadata-timeout-ms 3500 --max-peers-per-infohash 10
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65536
MemoryHigh=700M
MemoryMax=900M
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
