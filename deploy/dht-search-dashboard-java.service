[Unit]
Description=DHT Search Console dashboard (Java)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/vibe/dht-collector
EnvironmentFile=/etc/dht-search/db.env
EnvironmentFile=-/etc/dht-search/monitor-redis.env
ExecStart=/usr/bin/java -Xms32m -Xmx256m -XX:+UseG1GC -jar /opt/dht-collector/dht-collector-java.jar --mode dashboard --http-host 127.0.0.1 --http-port 4173 --pool-size 1 --static-path /root/vibe/dht-collector/web/public
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
